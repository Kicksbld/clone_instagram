# Valeurs de la démo (Supabase Cloud), lues par `pnpm db:seed:demo` uniquement (ADR-009).
# Copier en `.env.demo` (jamais versionné) et compléter. Aucune valeur secrète ici.

# Supabase Cloud → Connect → Session pooler (même URL que le service `api` de Railway).
DATABASE_URL=
# https://<ref>.supabase.co
SUPABASE_URL=
# Supabase Cloud → Settings → API Keys → clé « Secret ».
SUPABASE_SERVICE_ROLE_KEY=
# Facultative : username de ton compte sur la démo (onboarding terminé).
SEED_VIEWER_USERNAME=
