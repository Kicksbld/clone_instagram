{
  "name": "@clone/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.mjs",
    "lint": "eslint . && depcruise src",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:supabase": "vitest run --config vitest.supabase.config.ts",
    "build": "tsdown"
  },
  "dependencies": {
    "@clone/contract": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.4.0",
    "tsdown": "^0.23.0"
  }
}
