# Variables d'environnement (ADR-009). Copier en `.env` (jamais versionné) et compléter.
# Mêmes noms en local et sur la démo (Railway, Vercel). Aucune valeur secrète ici.

# --- API et worker ---------------------------------------------------------
# Postgres : « DB URL » de `supabase status` en local, Supabase Cloud en démo. Utilisée par drizzle-kit.
DATABASE_URL=
# Redis : service de `docker compose up -d` en local (port 6379).
REDIS_URL=
# Facultatives : 3000 et info par défaut.
API_PORT=
LOG_LEVEL=

# T2 et suivantes : Supabase (URL, clé service_role, vérification des JWT).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ISSUER=

# T3 : URL publique des médias, joignable depuis l'iPhone (IP du Mac en dev, pas localhost).
PUBLIC_MEDIA_BASE_URL=

# T10 : RevenueCat (API et worker pour la purge).
REVENUECAT_SECRET_KEY=
REVENUECAT_PROJECT_ID=

# T11 : PostHog (événements serveur ; lectures admin et purge).
POSTHOG_HOST=
POSTHOG_PROJECT_API_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# --- Backoffice (serveur Next.js uniquement, jamais exposé au navigateur) ---
# URL de l'API (en local : http://127.0.0.1 et API_PORT).
API_URL=
