// Configuration Local (ADR-009, ADR-010) : API et Supabase sur le Mac.
// Modèle versionné : copier en Local.xcconfig (non versionné), via `ios/scripts/bootstrap.sh`.
// Dans un .xcconfig, `//` commence un commentaire : écrire `http:/$()/…` dans les URL.

// URL de l'API. Simulateur : localhost. iPhone physique : IP du Mac (ex. http:/$()/192.168.1.20:3000).
API_BASE_URL = http:/$()/localhost:3000

// URL de Supabase Auth. Simulateur : localhost. iPhone physique : IP du Mac (ex. http:/$()/192.168.1.20:54321).
SUPABASE_URL = http:/$()/localhost:54321

// Clé publique (publishable) de Supabase, non secrète : « Publishable » de `supabase status`.
SUPABASE_PUBLISHABLE_KEY =

// Clé publique (Apple App Store) de RevenueCat, non secrète (Project Settings → API Keys, ADR-012).
REVENUECAT_API_KEY =

// Clé projet PostHog, non secrète (Project Settings → Project API key, ADR-013). Vide : aucun envoi, paywall `control`.
POSTHOG_API_KEY =

// Hôte PostHog (région UE).
POSTHOG_HOST = https:/$()/eu.i.posthog.com

// Team ID Apple du compte développeur (Sign in with Apple, achat intégré).
DEVELOPMENT_TEAM = CNLG2XPDKN
